# Adal Nexus – Backend env (copy to api/.env and fill in real values)

# ===== FIREBASE ADMIN SDK =====
# From your service-account JSON (Firebase Console > Project Settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===== AI (Groq) =====
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ===== TEST MODE =====
# When true (and NOT in production), X-Test-Mode: true header bypasses Firebase auth.
# Leave false in any shared/staging environment.
ENABLE_TEST_MODE=false
